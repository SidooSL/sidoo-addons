<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="reset_url_wizard_form_view" model="ir.ui.view">
        <field name="name">reset.url.wizard.form</field>
        <field name="model">reset.url.wizard</field>
        <field name="arch" type="xml">
            <form string="Password Reset URL">
                <sheet>
                    <group>
                        <field name="user_name" string="User"/>
                    </group>

                    <div class="alert alert-warning" role="alert">
                        <i class="fa fa-exclamation-triangle me-1"/>
                        This link is <strong>temporary</strong> and must be shared
                        <strong>only</strong> with the corresponding user.
                    </div>

                    <group string="Reset Link">
                        <field
                            name="reset_url"
                            widget="CopyClipboardChar"
                            string="URL"
                        />
                        <field name="hours_to_expire"/>
                        <field name="expires_at"/>
                    </group>
                </sheet>
                <footer>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
