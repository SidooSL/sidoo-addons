<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_wizard_account_company_sync_form" model="ir.ui.view">
        <field name="model">wizard.account.company.sync</field>
        <field name="arch" type="xml">
            <form string="Wizard Account Company Sync">
                <div class="alert alert-warning text-center" role="status">
                  <strong>This wizard will sync the selected accounts to the rest of the companies if they are not already created.</strong>
                </div>
                <group>
                    <field name="company_id" readonly="1" options="{'no_open': True}"/>
                    <field name="account_ids" widget="many2many_tags" options="{'no_open': True, 'no_create': True}"/>
                    <field name="company_ids" widget="many2many_tags" options="{'no_open': True, 'no_create': True}"/>
                </group>
                <footer>
                    <button string="Sync" type="object" name="action_sync_account" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_wizard_account_company_sync" model="ir.actions.act_window">
        <field name="name">Sync Accounts to Company</field>
        <field name="res_model">wizard.account.company.sync</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="wizard_account_company_sync_menu_main" name="Wizard Account Sync" parent="account.menu_finance_configuration" sequence="2"/>
    <menuitem id="wizard_account_company_sync_menu" parent="wizard_account_company_sync_menu_main" action="action_wizard_account_company_sync" sequence="20"/>

</odoo>
