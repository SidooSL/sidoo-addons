<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_account_tree_inherit" model="ir.ui.view">
        <field name="model">account.account</field>
        <field name='inherit_id' ref='account.view_account_list'/>
        <field name="arch" type="xml">
            <xpath expr="//tree" position="attributes">
                <attribute name="js_class">account_account_list_view</attribute>
            </xpath>
            <xpath expr="//field[@name='company_id']" position="before">
                <field name="active" widget="boolean_toggle"/>
            </xpath>
        </field>
    </record>

    <record id="action_sync_selected_accounts" model="ir.actions.act_window">
        <field name="name">Sync Selected Accounts</field>
        <field name="res_model">wizard.account.company.sync</field>
        <field name="binding_model_id" ref="account.model_account_account"/>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_account_ids': active_ids}</field>
    </record>

    <record id="action_queue_sync_all_accounts" model="ir.actions.server">
        <field name="name">Queue Sync All Accounts</field>
        <field name="model_id" ref="account.model_account_account"/>
        <field name="state">code</field>
        <field name="code">
            action = env['account.account'].enqueue_sync_accounts_across_companies()
        </field>
    </record>
</odoo>
