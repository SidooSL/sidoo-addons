<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_payment_mode_form_inherit" model="ir.ui.view">
        <field name="model">account.payment.mode</field>
        <field name="inherit_id" ref="account_payment_mode.account_payment_mode_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='payment_order_options']" position="after">
                <group
                    name="payment_order_transition_options"
                    string="Options for Payment Transition Account"
                >
                    <field name="compensation_account" />
                    <field name="transition_account_id"  invisible="not compensation_account"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
