#. module: whatsapp_conversation_extension
#: model_terms:ir.actions.act_window,help:whatsapp_conversation_extension.whatsapp_conversation_my_action
msgid ""
"List of WhatsApp conversations where you are a member. Only conversations\n"
"            that you have been added to or have participated in will appear here."
msgstr ""
"Listado de conversaciones de WhatsApp en las que eres miembro. Solo aparecerán\n"
"            las conversaciones a las que has sido añadido o en las que has participado."

#. module: whatsapp_conversation_extension
#: model_terms:ir.actions.act_window,help:whatsapp_conversation_extension.whatsapp_conversation_all_action
msgid ""
"List of all WhatsApp conversations. These are channels that have been created for\n"
"            WhatsApp messaging between your business and customers."
msgstr ""
"Listado de todas las conversaciones de WhatsApp. Estos son canales que se han creado\n"
"            para la mensajería de WhatsApp entre tu empresa y los clientes."

