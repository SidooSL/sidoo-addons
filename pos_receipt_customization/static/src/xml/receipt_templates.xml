<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <!-- Hide company logo and following br in receipt header -->
    <t t-name="point_of_sale.ReceiptHeader" t-inherit="point_of_sale.ReceiptHeader" t-inherit-mode="extension">
        <xpath expr="//img[@class='pos-receipt-logo']" position="attributes">
            <!-- Logo hidden to save space -->
            <attribute name="t-if">false</attribute>
        </xpath>
        <xpath expr="//img[@class='pos-receipt-logo']/following-sibling::br[1]" position="attributes">
            <!-- BR after logo also removed to save space -->
            <attribute name="t-if">false</attribute>
        </xpath>
        <xpath expr="//div[@t-if='props.data.company.email']" position="attributes">
            <attribute name="t-if">false</attribute>
        </xpath>
        <xpath expr="//div[@t-if='props.data.company.website']" position="attributes">
            <attribute name="t-if">false</attribute>
        </xpath>
        <xpath expr="//t[@t-name='point_of_sale.ReceiptHeader']/br[last()]" position="attributes">
            <!-- BR removed to save space -->
            <attribute name="t-if">false</attribute>
        </xpath>
    </t>
    <!-- Remove "Powered by Odoo" text from receipt footer -->
    <t t-name="point_of_sale.OrderReceipt" t-inherit="point_of_sale.OrderReceipt" t-inherit-mode="extension">
        <xpath expr="//div[@class='pos-receipt-order-data']/p[text()='Powered by Odoo']" position="attributes">
            <attribute name="t-if">false</attribute>
        </xpath>
    </t>
</templates>
