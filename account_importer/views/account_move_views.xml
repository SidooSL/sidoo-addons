<odoo>

    <record id="view_move_tree_inherit_payment_move_ids" model="ir.ui.view">
        <field name="name">account.move.tree.inherit.payment.move.ids</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='ref']" position="after">
                <field name="payment_move_ids" optional="hidden" />
            </xpath>
        </field>
    </record>

</odoo>
