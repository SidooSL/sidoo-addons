<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="partner_form_tier_filter" model="ir.ui.view">
        <field name="name">partner.form.tier.filter.automatic</field>
        <field name="model">res.partner</field>
        <field
            name="inherit_id"
            ref="partner_tier_validation.partner_form_tier_filter"
        />
        <field name="arch" type="xml">
            <filter name="needs_review" position="attributes">
                <attribute name="context">{'active_test': False}</attribute>
            </filter>
        </field>
    </record>
</odoo>
