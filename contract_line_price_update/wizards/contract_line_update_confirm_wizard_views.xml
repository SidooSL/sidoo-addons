<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_contract_line_update_confirm_wizard_form" model="ir.ui.view">
        <field name="name">contract.line.update.confirm.wizard.form</field>
        <field name="model">contract.line.update.confirm.wizard</field>
        <field name="arch" type="xml">
            <form string="Confirm Update Contract Line Prices">
                <div class="alert alert-warning warning_icon" role="alert">
                    <span class="fa fa-exclamation-triangle fa-2x"/>
                    <strong> Warning:</strong> This action is <strong>irreversible</strong> and will apply the indicated factor to the selected contract lines.
                    <br/><strong>Be sure to review the changes before confirming.</strong>
                </div>
                <group>
                    <group>
                        <field name="factor" readonly="1"/>
                        <field name="count_line" readonly="1"/>
                    </group>
                    <group>
                        <field name="output_type" widget="radio"/>
                    </group>
                </group>
                <footer>
                    <button name="confirm_update" type="object" class="btn-primary" string="Confirm and Apply"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
