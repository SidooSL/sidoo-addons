<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="contract_line_form_view" model="ir.ui.view">
        <field name="name">contract.line.form</field>
        <field name="model">contract.line</field>
        <field name="inherit_id" ref="contract.contract_line_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </xpath>
        </field>
    </record>

    <record id="contract_line_update_action_server" model="ir.actions.server">
        <field name="name">Update Contract Line Prices</field>
        <field name="groups_id" eval="[(4, ref('contract_line_price_update.group_contract_price_update'))]"/>
        <field name="model_id" ref="contract.model_contract_line"/>
        <field name="binding_model_id" ref="contract.model_contract_line" />
        <field name="state">code</field>
        <field name="code">
if records:
    action = records.action_contract_line_update_wizard()
        </field>
    </record>
</odoo>
