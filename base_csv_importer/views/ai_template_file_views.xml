<odoo>
    <record id="view_ai_template_file_form" model="ir.ui.view">
        <field name="name">ai.template.file.form</field>
        <field name="model">ai.template.file</field>
        <field name="arch" type="xml">
            <form string="AI Template File">
                <sheet>
                    <group>
                        <group>
                            <field name="type_id"/>
                            <field name="name"/>
                        </group>
                        <group>
                            <field name="job_record_count"/>
                            <field name="mapper_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
