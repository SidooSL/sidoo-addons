<odoo>
    <record id="view_ai_import_type_list" model="ir.ui.view">
        <field name="name">ai.import.type.list</field>
        <field name="model">ai.import.type</field>
        <field name="arch" type="xml">
            <list string="AI Import Types">
                <field name="name"/>
            </list>
        </field>
    </record>
    <record id="view_ai_import_type_form" model="ir.ui.view">
        <field name="name">ai.import.type.form</field>
        <field name="model">ai.import.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="bundle_ids"/>
                    </group>
                    <notebook>
                        <page string="Plantillas">
                            <field name="template_ids" editable="bottom">
                                <list>
                                    <field name='sequence' widget='handle'/>
                                    <field name="name"/>
                                    <field name="job_record_count"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
