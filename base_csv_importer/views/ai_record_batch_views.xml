<odoo>
    <record id="view_ai_record_batch_tree" model="ir.ui.view">
        <field name="name">ai.record.batch.tree</field>
        <field name="model">ai.record.batch</field>
        <field name="arch" type="xml">
            <tree>
                <field name="id"/>
                <field name="bundle_id"/>
                <field name="file_id"/>
                <field name="job_state"/>
            </tree>
        </field>
    </record>

    <record id="view_ai_record_batch_form" model="ir.ui.view">
        <field name="name">ai.record.batch.form</field>
        <field name="model">ai.record.batch</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="job_state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <field name="bundle_id"/>
                        <field name="file_id"/>
                        <field name="job_id"/>
                    </group>
                    <notebook>
                        <page string="Registros">
                            <field name="record_ids">
                                <tree>
                                    <field name="template_id"/>
                                    <field name="sequence"/>
                                    <field name="header"/>
                                    <field name="col1"/>
                                    <field name="col2"/>
                                    <field name="col3"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
