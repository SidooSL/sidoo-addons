<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="contract_line_search_view" model="ir.ui.view">
        <field name="name">contract.line.search.inherit</field>
        <field name="model">contract.line</field>
        <field name="inherit_id" ref="contract.contract_line_search_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='contract_id']" position="before">
                <field name="partner_id" string="Partner"/>
            </xpath>
            <xpath expr="//filter[@name='group_by_contract']" position="after">
                <filter name="product_id" string="Product" domain="[('product_id', '!=', False)]" context="{'group_by': 'product_id'}"/>
            </xpath>
        </field>
    </record>

    <record id="action_contract_line_tree" model="ir.actions.act_window">
        <field name="name">Contract Lines</field>
        <field name="res_model">contract.line</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No contract lines found. Edit an existing contract.
            </p>
        </field>
        <field name="context">{'create': False}</field>
    </record>

    <menuitem id="menu_contract_line"
              name="Contract Lines"
              parent="account.menu_finance_receivables"
              action="action_contract_line_tree"
              sequence="55"/>
</odoo>
