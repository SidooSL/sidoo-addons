<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="group_shared_filter_manager" model="res.groups">
            <field name="name">Shared Filter Management</field>
            <field name="category_id" ref="base.module_category_administration"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>
        <record id="rule_ir_filters_shared_delete_own_created" model="ir.rule">
            <field name="name">ir.filters.shared.delete.own.created</field>
            <field name="model_id" ref="base.model_ir_filters"/>
            <field name="domain_force">[('user_id', '=', False)]</field>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="True"/>
            <field name="groups" eval="[(4, ref('shared_filter_management.group_shared_filter_manager'))]"/>
        </record>
    </data>
</odoo>
